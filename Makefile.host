# Host-side test build for the pure modules in source/. Plain gcc, no devkitPro.
#   make -f Makefile.host        build + run tests
CC      ?= gcc
CFLAGS  := -g -O1 -Wall -Wextra -Wno-unused-parameter -std=gnu11 -Isource -Isource/external -fsanitize=address,undefined
SRCS    := $(wildcard source/*.c) source/external/littlemenu.c $(wildcard source_test/*.c)
OUT     := build_host/tests

.PHONY: test clean
test: $(OUT)
	./$(OUT)

$(OUT): $(SRCS) $(wildcard source/*.h) $(wildcard source_test/*.h)
	@mkdir -p build_host
	$(CC) $(CFLAGS) $(SRCS) -lm -o $@

clean:
	rm -rf build_host

# Image prescaler for bundled default puzzles (tools/prescale_defaults.sh)
build_host/prescale: tools/prescale.c source/imgscale.c source/imgscale.h
	@mkdir -p build_host
	$(CC) -O2 -Wall -Isource -Isource/external -Itools tools/prescale.c source/imgscale.c -lm -o $@

# App icon (icon.png in the project root is picked up by the 3DS Makefile)
build_host/makeicon: tools/makeicon.c source/edgegen.c source/imgscale.c source/rng.c source/edgegen.h source/imgscale.h
	@mkdir -p build_host
	$(CC) -O2 -Wall -Isource -Itools tools/makeicon.c source/edgegen.c source/imgscale.c source/rng.c -lm -o $@
