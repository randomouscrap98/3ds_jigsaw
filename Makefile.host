# Host-side test build for the pure modules in source/. Plain gcc, no devkitPro.
#   make -f Makefile.host        build + run tests
CC      ?= gcc
CFLAGS  := -g -O1 -Wall -Wextra -Wno-unused-parameter -std=gnu11 -Isource -Isource/external -Isource_app -fsanitize=address,undefined
SRCS    := $(wildcard source/*.c) source/external/littlemenu.c source/external/stb_vorbis.c source_app/storage.c $(wildcard source_test/*.c)
OUT     := build_host/tests

.PHONY: test clean
test: $(OUT)
	./$(OUT)

$(OUT): $(SRCS) $(wildcard source/*.h) source_app/storage.h $(wildcard source_test/*.h)
	@mkdir -p build_host
	$(CC) $(CFLAGS) $(SRCS) -lm -o $@

clean:
	rm -rf build_host

# Image prescaler for bundled default puzzles (tools/prescale_defaults.sh)
build_host/prescale: tools/prescale.c source/imgscale.c source/imgscale.h
	@mkdir -p build_host
	$(CC) -O2 -Wall -Isource -Isource/external -Itools tools/prescale.c source/imgscale.c -lm -o $@

# App icon + CIA banner (tools/makeart.c). icon.png in the project root is picked up by the
# 3DS Makefile; meta/banner.png by its cia target.
build_host/makeart: tools/makeart.c source/edgegen.c source/imgscale.c source/rng.c source/edgegen.h source/imgscale.h
	@mkdir -p build_host
	$(CC) -O2 -Wall -Isource -Itools tools/makeart.c source/edgegen.c source/imgscale.c source/rng.c -lm -o $@

# Random cut preview (tools/randcut_preview.c): renders every random style at 100/250/500
build_host/randcut_preview: tools/randcut_preview.c source/randcut.c source/edgegen.c source/piecegeo.c source/piecebake.c source/imgscale.c source/layout.c source/rng.c $(wildcard source/*.h)
	@mkdir -p build_host
	$(CC) -O2 -g -Wall -Wextra -Wno-unused-parameter -Isource -Isource/external -Itools tools/randcut_preview.c source/randcut.c source/edgegen.c source/piecegeo.c source/piecebake.c source/imgscale.c source/layout.c source/rng.c -lm -o $@
